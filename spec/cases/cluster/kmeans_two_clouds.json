{
  "spec_version": 1,
  "id": "cluster/kmeans_two_clouds",
  "description": "dos nubes separadas: dos grupos, centroides (0,0.5) y (10,10.5) por filas, inercia 1.0",
  "inputs": [
    {
      "dtype": "float64",
      "values": [0.0, 0.0, 10.0, 10.0]
    },
    {
      "dtype": "float64",
      "values": [0.0, 1.0, 10.0, 11.0]
    }
  ],
  "args": {
    "k": 2,
    "seed": 1
  },
  "op": "kmeans",
  "expect": {
    "columns": [
      {
        "dtype": "int64",
        "values": [0, 0, 1, 1]
      },
      {
        "dtype": "float64",
        "values": [0.0, 0.5, 10.0, 10.5]
      }
    ],
    "inertia": 1.0,
    "iterations": 2
  }
}
