{
  "spec_version": 1,
  "id": "linalg/lstsq_exact_line",
  "description": "puntos (0,1), (1,3), (2,5) sobre la recta y = 1 + 2x: x = [1, 2] y residuo 0",
  "inputs": [
    {
      "dtype": "float64",
      "values": [1.0, 1.0, 1.0]
    },
    {
      "dtype": "float64",
      "values": [0.0, 1.0, 2.0]
    }
  ],
  "input": {
    "dtype": "float64",
    "values": [1.0, 3.0, 5.0]
  },
  "op": "lstsq",
  "expect": {
    "columns": [
      {
        "dtype": "float64",
        "values": [1.0, 2.0]
      }
    ],
    "residual_norm": 0.0,
    "tolerance": 1e-12
  }
}
