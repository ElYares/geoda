{
  "spec_version": 1,
  "id": "model/regression_without_intercept",
  "description": "sin intercepto (fit_intercept = false) la recta y = 2x pasa por el origen: intercepto 0 y R^2 1",
  "inputs": [
    {
      "dtype": "float64",
      "values": [1.0, 2.0, 3.0]
    }
  ],
  "y": {
    "dtype": "float64",
    "values": [2.0, 4.0, 6.0]
  },
  "args": {
    "fit_intercept": false
  },
  "op": "regression_fit_predict",
  "expect": {
    "columns": [
      {
        "dtype": "float64",
        "values": [2.0]
      },
      {
        "dtype": "float64",
        "values": [2.0, 4.0, 6.0]
      }
    ],
    "intercept": 0.0,
    "r_squared": 1.0,
    "tolerance": 1e-12
  }
}
